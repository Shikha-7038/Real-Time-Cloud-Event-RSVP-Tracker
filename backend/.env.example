# Copy to .env - never commit the real file (already in .gitignore).

# Auth
SECRET_KEY=replace-with-a-long-random-string
TOKEN_TTL_SECONDS=86400

# Database - default is local SQLite. For the real cloud version, point
# this at your Supabase project's Postgres connection string instead:
#   DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres
DATABASE_URL=sqlite:///./event_rsvp.db

# CORS - restrict to your deployed frontend origin in production
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_PER_MINUTE=120

# --- If/when you switch to real Supabase Auth instead of this app's
# built-in JWT auth, you'd add: ---
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
