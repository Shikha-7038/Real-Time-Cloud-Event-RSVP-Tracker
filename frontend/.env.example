# In dev, Vite's proxy (vite.config.js) handles /api and /ws automatically -
# you don't need these locally. Set them when you deploy the frontend
# separately from the backend (e.g. Vercel frontend + Render backend).

VITE_API_BASE=https://your-backend.onrender.com/api
VITE_WS_BASE=wss://your-backend.onrender.com/ws
